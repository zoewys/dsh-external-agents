{
  "name": "dsh-external-agents",
  "version": "0.1.9",
  "type": "module",
  "description": "Kimi Code and Codex in native DeepSeek Harness conversations over ACP",
  "main": "./dist/host/index.js",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.3"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale/*.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.6.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-mcp-manager": "0.2.2-rc.3",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.3",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3"
  }
}
